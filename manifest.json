{
  "manifest_version": 3,
  "name": "Tidy Tabs - Smart Tab Organizer",
  "version": "2.2.1",
  "description": "Automatically organizes unpinned tabs into native Tab Groups with audio protection, multitasking grace period, Tab Vault stashing, and keyboard shortcuts.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "history"
  ],
  "commands": {
    "organize_tabs": {
      "suggested_key": {
        "default": "Alt+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Tidy & Sort all tabs in current window"
    },
    "toggle_focus": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Toggle Zen Focus Mode"
    },
    "stash_inactive": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Stash idle tabs into the Vault"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tidy Tabs Dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
